    width: 200px;

    margin: 10px;

    background: white;

    padding: 20px;

    border-radius: 10px;

    transition: 0.3s;

}

.feature:hover {

    transform: scale(1.05);

}

/* REVIEWS */

.review {

    background: white;

    margin: 10px auto;

    padding: 20px;

    width: 80%;

    border-radius: 10px;

}

/* FOOTER */

footer {

    background: black;

